# /etc/raftra/raftra.env — written by setup-node.sh. Example for node 1.
NODE_ID=node1
PUBLIC_HOSTNAME=raftra-n1.duckdns.org
# Raft gRPC between nodes uses PRIVATE IPs (port 50051 is never public).
PEERS=node2:172.26.0.12:50051,node3:172.26.0.13:50051
# Leader redirects (307) point at the other nodes' public HTTPS URLs.
HTTP_PEERS=node2:https://raftra-n2.duckdns.org,node3:https://raftra-n3.duckdns.org
LIMIT_FLAGS=-max-key-bytes 128 -max-value-bytes 1024 -max-keys 10000 -write-rate 5 -write-burst 10 -trust-proxy -cors-origin https://shantanu-1607.github.io
