[Unit]
Description=Raftra node (public playground)
After=network-online.target
Wants=network-online.target

[Service]
User=raftra
Group=raftra
EnvironmentFile=/etc/raftra/raftra.env
# ${VAR} is passed as one argument; $LIMIT_FLAGS is split on spaces into several.
ExecStart=/usr/local/bin/raftra-server -id ${NODE_ID} -host 0.0.0.0 -port 50051 -http-port 8001 -data-dir /var/lib/raftra -peers ${PEERS} -http-peers ${HTTP_PEERS} $LIMIT_FLAGS
# Chaos SIGKILLs the leader; systemd brings it back 45 s later so the
# landing page can show the dead node, the new election and the rejoin.
Restart=on-failure
RestartSec=45
LimitNOFILE=65536

# Containment: if a flood of writes grows the log too far, systemd kills and
# restarts only this service instead of the whole 512 MB machine thrashing.
MemoryMax=300M

# Sandbox: the process can only write its data directory, gains no privileges,
# and cannot see home directories, devices or kernel settings.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/raftra
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
